# 가디언 Open Platform 무료 개발자 키 (https://open-platform.theguardian.com/access/)
# 이 파일을 .env로 복사한 뒤 값을 채운다. .env는 커밋 금지.
GUARDIAN_API_KEY=

# Neon PostgreSQL 접속 주소 (https://neon.tech → 프로젝트 → Connect에서 복사)
# 비밀번호가 들어 있다. .env에만 넣고 이 파일에는 절대 넣지 않는다.
DATABASE_URL=

# Gemini API 키 (https://aistudio.google.com → API Keys). 기사 번역에 쓴다. .env에만 넣는다.
GEMINI_API_KEY=
